# ─────────────────────────────────────────────────────────────
# PortfolioAI — environment variables (TEMPLATE)
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# In production these are set in the Railway service's Variables tab.
# ─────────────────────────────────────────────────────────────

# Claude / Anthropic — required for /explain and /chat
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase — required for /waitlist, /track, /analytics
# Use the service_role key (server-side inserts bypass RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Admin key protecting GET /analytics (sent as the X-Admin-Key header)
ADMIN_KEY=choose-a-long-random-string

# ── Optional: in-app support email flow (currently dormant) ──
# See docs/dormant-support-flow.md before enabling.
RESEND_API_KEY=your-resend-api-key
SUPPORT_EMAIL_TO=you@example.com
SUPPORT_EMAIL_FROM=onboarding@resend.dev
