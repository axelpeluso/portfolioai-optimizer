# ─────────────────────────────────────────────────────────────
# PortfolioAI — environment variables (TEMPLATE)
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# In production these are set in the Railway service's Variables tab.
# ─────────────────────────────────────────────────────────────

# Claude / Anthropic — required for /explain and /chat
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase — required for /waitlist, /track, /analytics
# Use the service_role key (server-side inserts bypass RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Admin key protecting GET /analytics (sent as the X-Admin-Key header)
ADMIN_KEY=choose-a-long-random-string

# ── SnapTrade — read-only brokerage import (optional) ────────
# Unset = the feature is simply off: /snaptrade/status reports enabled:false
# and the frontend hides the Connect brokerage button.
SNAPTRADE_CLIENT_ID=FINVENTURE-TEST-YHVEL
SNAPTRADE_CONSUMER_KEY=qdtvDLQHjGxR4GBlgcMrc5kLfUJV0uiWYuwNryBswKxsvVpXtu

# Encrypts each SnapTrade userSecret before it is stored. That secret is a
# bearer credential to someone's brokerage data, so it is not left in plaintext
# behind the (broad) service_role key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every stored connection — users reconnect.
SNAPTRADE_ENCRYPTION_KEY=your-generated-fernet-key

# Comma-separated CORS allowlist. Defaults to "*" when unset.
# Note on what this does and does not do: bearer tokens live in the browser's
# sessionStorage, which is already origin-scoped, so "*" does not by itself let
# another site read a visitor's holdings. Setting this is defence in depth and
# limits who can hit the API at all — worth doing once real accounts exist.
# ALLOWED_ORIGINS=https://portfolioai-optimizer.vercel.app,http://localhost:5500

# ── Optional: in-app support email flow (currently dormant) ──
# See docs/dormant-support-flow.md before enabling.
RESEND_API_KEY=your-resend-api-key
SUPPORT_EMAIL_TO=you@example.com
SUPPORT_EMAIL_FROM=onboarding@resend.dev
